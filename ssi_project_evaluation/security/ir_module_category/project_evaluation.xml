<odoo>
<!-- Parent categories for all project-related security groups -->
<record id="project_workflow_module_category" model="ir.module.category">
    <field name="name">SSI Project</field>
    <field name="sequence" eval="10" />
</record>

<record id="project_data_ownership_module_category" model="ir.module.category">
    <field name="name">SSI Project Data Ownership</field>
    <field name="sequence" eval="10" />
</record>

<record id="project_configurator_module_category" model="ir.module.category">
    <field name="name">SSI Project Configurator</field>
    <field name="sequence" eval="10" />
</record>

<!-- Project Evaluation specific categories -->
<record id="project_evaluation_workflow_module_category" model="ir.module.category">
    <field name="name">Project Evaluation</field>
    <field name="parent_id" ref="project_workflow_module_category" />
</record>

<record
        id="project_evaluation_data_ownership_module_category"
        model="ir.module.category"
    >
    <field name="name">Project Evaluation</field>
    <field name="parent_id" ref="project_data_ownership_module_category" />
</record>

</odoo>
