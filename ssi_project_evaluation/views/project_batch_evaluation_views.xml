<odoo>
<record id="project_batch_evaluation_view_tree" model="ir.ui.view">
    <field name="name">project_batch_evaluation - Tree</field>
    <field name="model">project_batch_evaluation</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="type_id" />
                <field name="date" />
                <field name="date_start" />
                <field name="date_end" />
            </xpath>
        </data>
    </field>
</record>

<record id="project_batch_evaluation_view_search" model="ir.ui.view">
    <field name="name">project_batch_evaluation - Search</field>
    <field name="model">project_batch_evaluation</field>
    <field name="mode">primary</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="type_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="project_batch_evaluation_view_form" model="ir.ui.view">
    <field name="name">project_batch_evaluation - Form</field>
    <field name="model">project_batch_evaluation</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field
                        name="type_id"
                        attrs="{'readonly': [('state', '!=', 'draft')]}"
                    />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}" />
                <field
                        name="date_start"
                        attrs="{'readonly': [('state', '!=', 'draft')]}"
                    />
                <field
                        name="date_end"
                        attrs="{'readonly': [('state', '!=', 'draft')]}"
                    />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="project" string="Projects">
                    <group name="project_button_group" colspan="2" col="2">
                        <button
                                name="action_load_project"
                                string="Load Projects"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"
                            />
                    </group>
                    <field
                            name="project_ids"
                            nolabel="1"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        >
                        <tree>
                            <field name="name" />
                        </tree>
                    </field>
                </page>
                <page name="evaluation" string="Evaluations">
                    <group
                            name="queue_info_group"
                            colspan="2"
                            col="2"
                            string="Queue Info"
                        >
                        <field name="queue_job_batch_id" />
                        <field name="queue_job_batch_state" />
                    </group>
                    <group name="evaluation_action_group" colspan="2" col="2">
                        <button
                                name="action_open_evaluation"
                                string="Open Evaluations"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('queue_job_batch_id', '=', False)]}"
                            />
                        <button
                                name="action_start_evaluation"
                                string="Start Queue"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('queue_job_batch_state', 'not in', ['draft'])]}"
                            />
                        <button
                                name="action_confirm_evaluation"
                                string="Confirm Queue"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('queue_job_batch_state', 'not in', ['enqueued', 'started'])]}"
                            />
                        <button
                                name="action_approve_evaluation"
                                string="Approve Queue"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('queue_job_batch_state', 'not in', ['enqueued', 'started', 'partially_complete'])]}"
                            />
                        <button
                                name="action_cancel_evaluation"
                                string="Cancel Queue"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('queue_job_batch_state', 'not in', ['enqueued', 'started', 'partially_complete', 'failed'])]}"
                            />
                        <button
                                name="action_restart_evaluation"
                                string="Restart Queue"
                                type="object"
                                class="oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('queue_job_batch_state', 'not in', ['cancelled'])]}"
                            />
                    </group>
                    <field name="evaluation_ids" nolabel="1">
                        <tree>
                            <field name="name" />
                            <field name="project_id" />
                            <field name="date" />
                            <field name="state" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="project_batch_evaluation_action" model="ir.actions.act_window">
    <field name="name">Project Batch Evaluations</field>
    <field name="res_model">project_batch_evaluation</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{
        "search_default_dom_draft": 1,
        "search_default_dom_confirm": 1,
    }</field>
</record>

<menuitem
        id="project_batch_evaluation_menu"
        name="Batch Evaluations"
        parent="menu_project_evaluation_header"
        action="project_batch_evaluation_action"
        groups="project_batch_evaluation_viewer_group"
        sequence="120"
    />
</odoo>
